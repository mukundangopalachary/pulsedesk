#!/usr/bin/env bash
# Runs the same checks as .github/workflows/ci.yml before every push.
# Skip once with:  SKIP_CHECKS=1 git push   (or git push --no-verify)
set -u

if [ "${SKIP_CHECKS:-0}" = "1" ]; then
  echo "pre-push: SKIP_CHECKS=1, skipping checks."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

step() {
  local name="$1"; shift
  printf '\n==> %s\n' "$name"
  if ! "$@"; then
    printf '\npre-push: "%s" failed. Push aborted. Fix it, or skip once with SKIP_CHECKS=1 git push\n' "$name" >&2
    exit 1
  fi
}

step "lint"       npm run --silent lint
step "typecheck"  npm run --silent typecheck
step "build"      env VITE_SUPABASE_URL="${VITE_SUPABASE_URL:-https://example.supabase.co}" \
                      VITE_SUPABASE_ANON_KEY="${VITE_SUPABASE_ANON_KEY:-ci-placeholder}" \
                      npm run --silent build
step "npm audit (production deps, high+)" npm audit --omit=dev --audit-level=high

printf '\npre-push: all checks passed.\n'
